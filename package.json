{
  "name": "between-pages",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "node checks/install-hooks.ts",
    "dev:api": "npm run dev -w @between-pages/api",
    "dev:web": "npm run dev -w @between-pages/web",
    "dev:oidc": "npm run dev:oidc -w @between-pages/api",
    "build": "npm run build -w @between-pages/web",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "npm run db:migrate -w @between-pages/api",
    "db:generate": "npm run db:generate -w @between-pages/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces && tsc -p checks && tsc -p e2e",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "bash scripts/with-test-postgres.sh npm run test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:db": "bash scripts/with-test-postgres.sh npm run test:e2e",
    "openapi": "npm run openapi -w @between-pages/api",
    "adr:index": "node checks/generate-adr-index.ts",
    "check": "node checks/check.ts",
    "test:prototypes": "node --test prototypes/collaboration/test/core.test.mjs prototypes/collaboration/test/policy.test.mjs prototypes/yjs/core.test.mjs",
    "test:pg": "node --test prototypes/collaboration/test/postgres.test.mjs",
    "test:pg:docker": "bash scripts/test-collab-postgres.sh",
    "test:browser": "node --test prototypes/collaboration/test/browser.test.mjs",
    "test:browser:pg": "COLLAB_TEST_SUITE=test:browser bash scripts/test-collab-postgres.sh",
    "benchmark:collab": "node prototypes/collaboration/test/performance.mjs",
    "benchmark:yjs:smoke": "COLLAB_ENGINE=yjs COLLAB_PERF_SIZES=1000,5000,10000 node prototypes/collaboration/test/performance.mjs",
    "benchmark:yjs:history": "COLLAB_ENGINE=yjs COLLAB_PERF_SIZES=1000 COLLAB_PERF_CHUNK_SIZE=5 node prototypes/collaboration/test/performance.mjs",
    "benchmark:yjs:smoke:pg": "COLLAB_TEST_SUITE=benchmark:yjs:smoke bash scripts/test-collab-postgres.sh",
    "dev:probe": "node prototypes/collaboration/browser/server.mjs",
    "test:yjs": "node --test prototypes/yjs/core.test.mjs",
    "test:yjs:pg": "COLLAB_ENGINE=yjs COLLAB_TEST_SUITE=test:pg bash scripts/test-collab-postgres.sh",
    "test:yjs:browser": "COLLAB_ENGINE=yjs node --test prototypes/collaboration/test/browser.test.mjs",
    "test:yjs:browser:pg": "COLLAB_ENGINE=yjs COLLAB_TEST_SUITE=test:browser bash scripts/test-collab-postgres.sh",
    "dev:yjs": "COLLAB_ENGINE=yjs node prototypes/collaboration/browser/server.mjs",
    "test:auth:pg": "COLLAB_TEST_SUITE=test:auth bash scripts/test-collab-postgres.sh",
    "test:auth": "node --test prototypes/auth/auth.test.mjs"
  },
  "dependencies": {
    "pg": "8.23.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.8",
    "ws": "8.22.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "oauth2-mock-server": "9.3.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "y-prosemirror": "1.3.7"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
