        "summary": "Open the caller's diary for today in the given time zone, or for a past date, creating it if missing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenDiaryRequestInput"
