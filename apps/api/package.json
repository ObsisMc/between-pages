{
  "name": "@between-pages/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "node --env-file-if-exists=../../.env --watch src/worker/main.ts",
    "start:worker": "node --env-file-if-exists=../../.env src/worker/main.ts",
    "openapi": "node scripts/generate-openapi.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts",
    "auth:generate": "npx -y auth@1.7.12 generate --config scripts/auth-cli.ts --output src/db/auth-schema.ts --yes",
    "dev:oidc": "node scripts/dev-oidc.ts"
  },
  "dependencies": {
    "@between-pages/collab": "0.0.1",
    "@between-pages/contracts": "0.0.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/websocket": "11.3.4",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "oauth2-mock-server": "9.3.0"
  }
}
