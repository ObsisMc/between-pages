# Copy to /etc/between-pages/app.env (owner root, mode 600). Never commit real values.
# Read by the api, worker and migrate containers.

HOST=0.0.0.0
PORT=3000

# Same password as POSTGRES_PASSWORD in backup.env. Host `postgres` is the compose service.
DATABASE_URL=postgresql://between_pages:<password>@postgres:5432/between_pages

PUBLIC_ORIGIN=https://missu.ruihaozhang.com
AUTH_PROVIDER=google

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# The production Google client, for login and Drive. Development keeps its own.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# openssl rand -base64 32. Keep a copy in your password manager: it seals the Drive grants.
GOOGLE_TOKEN_KEY=

# Email reminders (email-reminders ADR, README.md 「开启邮件提醒」). Fill the three together;
# left empty, the worker sends nothing. With RESEND_API_KEY but without the other two, the
# api and worker refuse to start.
# Resend → API Keys, Sending access for the mail domain only.
RESEND_API_KEY=
# The verified domain's sender, e.g. Between Pages <remind@mail.ruihaozhang.com> (no quotes).
MAIL_FROM=
# openssl rand -base64 32. Changing it breaks the unsubscribe links of mails already sent.
MAIL_TOKEN_KEY=
