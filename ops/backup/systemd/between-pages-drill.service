# Weekly restore drill (ops/backup/README.md). Set WorkingDirectory and the Node 26 path as above.
[Unit]
Description=Between Pages weekly restore drill
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/volumes/between-pages
EnvironmentFile=/etc/between-pages/backup.env
ExecStart=/home/ubuntu/.nvm/versions/node/v26.12.1/bin/node ops/backup/drill.ts
