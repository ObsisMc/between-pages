# Copy to /etc/between-pages/backup.env (owner root, mode 600). Never commit real values.
# Read by the database container (compose.backup.yaml) and by the backup, restore and
# drill scripts (systemd EnvironmentFile).

# This file's own path, for the containers the restore and drill start.
BACKUP_ENV_FILE=/etc/between-pages/backup.env

# Compose files and project, relative to the repository root.
COMPOSE_FILE=compose.yaml:ops/backup/compose.backup.yaml
COMPOSE_PROJECT_NAME=between-pages

# Cloudflare R2 (S3-compatible). The token may only read and write this bucket.
WALG_S3_PREFIX=s3://<bucket>/between-pages
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Encryption before upload: 32 random bytes as 64 hex characters (openssl rand -hex 32).
# Keep a copy in your password manager. Losing it makes every backup unreadable.
WALG_LIBSODIUM_KEY=
WALG_LIBSODIUM_KEY_TRANSFORM=hex

# Daily backups send only changed pages; every seventh, and the monthly one, is full.
WALG_DELTA_MAX_STEPS=6
WALG_COMPRESSION_METHOD=zstd

# Healthchecks.io check URLs (https://hc-ping.com/<uuid>).
HC_BACKUP_URL=
HC_DRILL_URL=

# The live database, for the weekly drill to compare against (same value as the app's .env).
LIVE_DATABASE_URL=
# Where the drill keeps the counts of its last run.
DRILL_STATE_FILE=/var/lib/between-pages/drill-state.json
