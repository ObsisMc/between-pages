# Copy to .env. Read by the API (apps/api/src/server.ts) and by the web dev proxy
# (apps/web/vite.config.ts), so both agree on the API port.
PORT=3000
HOST=127.0.0.1

# Local database started by `npm run db:up` (compose.yaml). Keep the port in both lines equal.
DB_PORT=54320
DATABASE_URL=postgresql://between_pages:local-dev-only@127.0.0.1:54320/between_pages

# Login (authentication-and-sessions ADR, D11). PUBLIC_ORIGIN is the address the browser
# uses: the Vite dev server, which proxies /api to the API.
PUBLIC_ORIGIN=http://localhost:5173
# LOCAL DEVELOPMENT ONLY. Production uses its own value from: openssl rand -base64 32
BETTER_AUTH_SECRET=local-development-only-secret-do-not-deploy-0000
# dev = mock login (`npm run dev:oidc`), google = real Google (needs GOOGLE_CLIENT_ID/SECRET)
AUTH_PROVIDER=dev
DEV_OIDC_ISSUER=http://127.0.0.1:4010
# Google Drive readable copy (server-backup-and-google-docs; apps/api/README.md#setting-up-google-drive-ray).
# Needs GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET (the login client) whatever AUTH_PROVIDER is;
# off while any of the three is unset.
# GOOGLE_TOKEN_KEY=   # openssl rand -base64 32
# The Google app is in Testing: Drive grants expire after seven days.
# GOOGLE_DRIVE_TESTING=true
# End-to-end tests only (needs AUTH_PROVIDER=dev): history points close after this many ms
# without a commit instead of two minutes. Leave unset for development and production.
# HISTORY_IDLE_MS=3000
